{% extends 'base.html.twig' %}

{% block body %}
    {% block javascripts %}
        <script src="{{ asset('js/listener.js') }}"></script>
    {% endblock %}

    <h1>{{ title }}</h1>

    {% if age is defined %}
        {% if age < 18 %}
            <p>tu es mineur</p>
        {% elseif age >= 18 %}
            <p>tu es majeur</p>
        {% endif %}
    {% endif %}

    {% if errorLogin is defined %}
        <div class="toast show"
             style="position: absolute; top: 5rem; right: 1rem;"
             role="alert"
             aria-live="assertive"
             aria-atomic="true"
             data-bs-delay="4000">

            <div class="toast-header">
                <strong class="me-auto">Error Login</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>

            <div class="toast-body">
                <h2 class="text-danger">{{ errorLogin }}</h2>
            </div>
        </div>
    {% endif %}
{% endblock %}
