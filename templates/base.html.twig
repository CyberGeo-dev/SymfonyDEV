<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>

    <link rel="stylesheet" href="https://bootswatch.com/5/flatly/bootstrap.min.css">
    <link rel="stylesheet" href="{{ asset('css/login.css') }}">
    <link rel="stylesheet" href="{{ asset('css/main.css') }}">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    {% block stylesheets %}{% endblock %}
</head>

<body>

{% set filter = app.session.get('filter') %}
{% if filter != null %}
    {% set idRole = filter['idRole'] %}
    {% set idUser = filter['idUser'] %}
    {% set username = filter['username'] %}
{% endif %}

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">eCommerce</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarColor01">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link" href="/">Home</a></li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('test', {'name':'world'}) }}">Créer un article</a>
                </li>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Dropdown</a>
                    <ul class="dropdown-menu">
                        {% if idRole is defined and idRole == 1 %}
                            <li><a class="dropdown-item" href="{{ path('account') }}">Créer un utilisateur</a></li>
                        {% endif %}
                    </ul>
                </li>
            </ul>

            <ul class="navbar-nav ms-auto">
                {% if username is not defined %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle btn btn-outline-light px-3" href="#" role="button" data-bs-toggle="dropdown">
                            Login
                        </a>
                        <div class="dropdown-menu dropdown-menu-end p-3">
                            <form method="post" action="{{ path('login') }}">
                                <div class="mb-2">
                                    <input class="form-control form-control-sm" type="text" name="username" placeholder="username" required>
                                </div>
                                <div class="mb-3">
                                    <input class="form-control form-control-sm" type="password" name="password" placeholder="Password" required>
                                </div>
                                <button class="btn btn-primary w-100" type="submit">Login</button>
                            </form>
                        </div>
                    </li>
                {% else %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            Bienvenue {{ username }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" href="{{ path('account-edit', {'id': idUser}) }}">Mon compte</a>
                            </li>
                        </ul>
                    </li>

                    <li class="nav-item ms-2">
                        <a class="nav-link" title="Logout" href="{{ path('logout') }}">
                            <i class="fas fa-sign-out-alt"></i>
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

<main class="container py-4">
    {% block body %}{% endblock %}
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>